[Unit]
Description=SIP OPTIONS probe of the PBX (over the tailnet)
After=network-online.target tailscaled.service
[Service]
Type=oneshot
User=prometheus
ExecStart=/usr/bin/python3 /opt/monitoring/scripts/sip-options-probe.py pbx2=100.64.0.12:5060/udp
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
PrivateTmp=true
