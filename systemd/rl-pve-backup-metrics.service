[Unit]
Description=Backup freshness metrics from Proxmox task logs
After=network-online.target tailscaled.service
[Service]
Type=oneshot
User=prometheus
LoadCredential=pve_api_token:/opt/monitoring/secrets/pve_api_token
StateDirectory=rl-monitoring
ExecStart=/usr/bin/python3 /opt/monitoring/scripts/pve-backup-metrics.py
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
PrivateTmp=true
