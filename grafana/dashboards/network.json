  {
   "id": 7,
   "type": "timeseries",
   "title": "WAN throughput (gateway eth4)",
   "description": "",
   "gridPos": {
    "x": 15,
    "y": 1,
    "w": 9,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(ifHCInOctets{job=\"snmp-gateway\", ifDescr=\"eth4\"}[5m]) * 8",
     "refId": "A",
     "instant": false,
     "range": true,
     "legendFormat": "download"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(ifHCOutOctets{job=\"snmp-gateway\", ifDescr=\"eth4\"}[5m]) * 8",
     "refId": "B",
     "instant": false,
     "range": true,
     "legendFormat": "upload"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
