  {
   "id": 10,
   "type": "table",
   "title": "Link quality matrix",
   "description": "Each row is one direction of one link. 'From' is the site doing the measuring.",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg by (host, to) (rl_mesh_rtt_seconds{stat=\"avg\", path=\"overlay\"})",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg by (host, to) (rl_mesh_loss_ratio{path=\"overlay\"})",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg by (host, to) (rl_mesh_rtt_seconds{stat=\"jitter\", path=\"overlay\"})",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Latency"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 0.12
          },
          {
           "color": "red",
           "value": 0.25
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "decimals",
        "value": 3
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Loss"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 0.02
          },
          {
           "color": "red",
           "value": 0.1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Jitter"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 4
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "host": "From",
       "to": "To",
       "Value #A": "Latency",
       "Value #B": "Loss",
       "Value #C": "Jitter"
      },
      "indexByName": {
       "host": 0,
       "to": 1,
       "Value #A": 2,
       "Value #B": 3,
       "Value #C": 4
      }
     }
    }
   ]
  },
