  {
   "id": 9,
   "type": "timeseries",
   "title": "VPN state",
   "description": "Anything above 0 means downloads are paused or the client was stopped.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rl_vpn_state_code)",
     "refId": "A",
     "instant": false,
     "range": true,
     "format": "table",
     "legendFormat": "0 healthy / 1 degraded / 2 critical"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
