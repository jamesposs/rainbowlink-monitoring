 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Download client & Mullvad VPN",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "VPN protection",
   "description": "HEALTHY: tunnel up, egress verified as a Mullvad exit, DNS via Mullvad, kill switch proven. DEGRADED: nothing can leak but the tunnel/provider is not working (downloads paused). CRITICAL: possible non-Mullvad path - qBittorrent is stopped and an alert is paged.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rl_vpn_state_code)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "HEALTHY",
         "color": "#22C55E",
         "index": 0
        },
        "1": {
         "text": "DEGRADED",
         "color": "#FFA726",
         "index": 1
        },
        "2": {
         "text": "CRITICAL",
         "color": "#EF4444",
         "index": 2
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22C55E",
        "value": null
       },
       {
        "color": "#FFA726",
        "value": 1
       },
       {
        "color": "#EF4444",
        "value": 2
       }
      ]
     },
     "noValue": "No data"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
