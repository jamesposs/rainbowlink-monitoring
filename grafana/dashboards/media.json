  {
   "id": 12,
   "type": "table",
   "title": "Relay and torrents",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (relay, exit) (rl_vpn_relay_info)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (state) (rl_vpn_qbit_torrents)",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value #A": true
      },
      "renameByName": {}
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 13,
   "type": "table",
   "title": "Host",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host) (up{job=\"node\", host=~\"dl|arr\"})",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host) (1 - node_memory_MemAvailable_bytes{host=~\"dl|arr\"} / node_memory_MemTotal_bytes{host=~\"dl|arr\"})",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host) (1 - node_filesystem_avail_bytes{host=~\"dl|arr\", mountpoint=\"/\"} / node_filesystem_size_bytes{host=~\"dl|arr\", mountpoint=\"/\"})",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host) (time() - node_boot_time_seconds{host=~\"dl|arr\"})",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "Up",
       "Value #B": "Memory used",
       "Value #C": "Disk used",
       "Value #D": "Uptime (s)"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
