 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Service checks (does it actually work?)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "table",
   "title": "All service checks",
   "description": "Internal checks (probed from the monitoring server) and public ones (job http-public, probed from outside via vps-sjc).",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 14
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (key, service, host, site, probed_from) (label_replace(label_replace(label_join(probe_success{job=~\"http|tcp|http-public\"}, \"key\", \"|\", \"job\", \"instance\"), \"probed_from\", \"internet\", \"job\", \"http-public\"), \"probed_from\", \"inside\", \"job\", \"http|tcp\"))",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (key) (label_join(probe_duration_seconds{job=~\"http|tcp|http-public\"}, \"key\", \"|\", \"job\", \"instance\"))",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (key) (label_join(probe_http_status_code{job=~\"http|http-public\"}, \"key\", \"|\", \"job\", \"instance\"))",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (key) (label_join(probe_ssl_earliest_cert_expiry{job=~\"http|http-public\"} - time(), \"key\", \"|\", \"job\", \"instance\"))",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#6b7280",
           "value": null
          },
          {
           "color": "green",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "OK",
            "color": "green"
           },
           "0": {
            "text": "FAIL",
            "color": "red"
           }
          }
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 100
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Checked from"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 110
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Time"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "HTTP"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 70
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Cert expires in"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dtdurations"
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#6b7280",
           "value": null
          },
          {
           "color": "red",
           "value": 0
          },
          {
           "color": "orange",
           "value": 604800
          },
          {
           "color": "green",
           "value": 1814400
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Status",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "key",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "key": true
      },
      "renameByName": {
       "service": "Service",
       "host": "Runs on",
       "site": "Site",
       "probed_from": "Checked from",
       "Value #A": "Status",
       "Value #B": "Time",
       "Value #C": "HTTP",
       "Value #D": "Cert expires in"
      },
      "indexByName": {
       "service": 0,
       "probed_from": 1,
       "host": 2,
       "site": 3,
       "Value #A": 4,
       "Value #C": 5,
       "Value #B": 6,
       "Value #D": 7
      }
     }
    }
   ]
  },
