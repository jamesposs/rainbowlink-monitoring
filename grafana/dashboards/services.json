{
 "uid": "rl-services",
 "title": "Services",
 "tags": [
  "rainbowlink",
  "services"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "links": [
  {
   "title": "Overview",
   "type": "link",
   "url": "/d/rl-overview",
   "icon": "dashboard",
   "targetBlank": false
  },
  {
   "title": "Site map",
   "type": "link",
   "url": "/d/rl-map",
   "icon": "dashboard",
   "targetBlank": false
  },
  {
   "title": "Network",
   "type": "link",
   "url": "/d/rl-network",
   "icon": "dashboard",
   "targetBlank": false
  },
  {
   "title": "Servers & storage",
   "type": "link",
   "url": "/d/rl-servers",
   "icon": "dashboard",
