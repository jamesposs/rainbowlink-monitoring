       "type": "value",
       "options": {
        "1": {
         "text": "PASSED",
         "color": "green"
        },
        "0": {
         "text": "FAILED",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
