  {
   "id": 15,
   "type": "timeseries",
   "title": "sda latency per I/O (ms)",
   "description": "A healthy 5400-rpm disk is ~10-20 ms per random I/O; this SMR drive normally runs ~80-100 ms. Red line = alert PveHddLatencyHigh (250 ms for 30 min).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 6,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 250
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_disk_read_time_seconds_total{instance=\"pve0\",device=\"sda\"}[5m]) / rate(node_disk_reads_completed_total{instance=\"pve0\",device=\"sda\"}[5m]) * 1000",
     "legendFormat": "read",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_disk_write_time_seconds_total{instance=\"pve0\",device=\"sda\"}[5m]) / rate(node_disk_writes_completed_total{instance=\"pve0\",device=\"sda\"}[5m]) * 1000",
     "legendFormat": "write",
     "refId": "B"
    }
   ]
  },
