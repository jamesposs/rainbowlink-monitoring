  {
   "id": 10,
   "type": "table",
   "title": "Active alerts",
   "description": "Everything firing or about to fire (pending = condition true, still inside its grace period). Empty table = all quiet.",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 16,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS_FOR_STATE{severity!=\"none\"}",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Severity"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "orange",
           "value": null
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "critical": {
            "text": "critical",
            "color": "red"
           },
           "warning": {
            "text": "warning",
            "color": "orange"
           }
          }
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Since"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeFromNow"
       },
       {
        "id": "custom.width",
        "value": 140
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Site"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 60
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Since",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "calculateField",
     "options": {
      "mode": "binary",
      "binary": {
       "left": "Value",
       "operator": "*",
       "right": "1000"
      },
      "alias": "Since",
      "replaceFields": false
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "monitor": true,
       "alertstate": true,
       "critical": true,
       "ts_ip": true,
       "addr": true,
       "role": true,
       "kind": true,
       "parent": true,
       "module": true,
       "alertname_family": true,
       "storage": true,
       "vmid": true,
       "name": true,
       "id": true,
       "path": true,
       "stat": true,
       "component": true,
       "diskID": true,
       "trunk": true,
       "status": true,
       "mountpoint": true,
       "device": true,
       "fstype": true,
       "service": true,
       "unit": true,
       "type": true,
       "target": true,
       "proto": true,
       "wan_target": true,
       "critical_group": true
      },
      "indexByName": {
       "severity": 0,
       "alertname": 1,
       "host": 2,
       "site": 3,
       "Since": 4
      },
      "renameByName": {
       "severity": "Severity",
       "alertname": "Alert",
       "host": "Where",
       "site": "Site"
      }
     }
    }
   ]
  },
