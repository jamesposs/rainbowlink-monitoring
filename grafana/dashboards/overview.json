   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(probe_ssl_earliest_cert_expiry{job=~\"http|http-public\"} - time())",
     "refId": "A",
     "instant": true,
     "range": false
