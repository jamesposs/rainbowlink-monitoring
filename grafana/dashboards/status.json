  {
   "id": 20,
   "type": "table",
   "title": "What is firing right now",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 7
   },
   "description": "Alerts that have waited out their own delay. A tile can be Degraded before anything shows here (it reacts after ~3 minutes; alerts after 5-15).",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "alertstate": true,
       "job": true,
       "instance": true,
       "kind": true,
       "parent": true,
       "role": true,
       "monitor": true
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity",
       "host": "Host",
       "site": "Site",
       "service": "Service"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "Nothing is firing",
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Severity"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "critical": {
            "color": "#EF4444",
            "index": 0
           },
           "warning": {
            "color": "#FFA726",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
