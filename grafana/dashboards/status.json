 "description": "One tile per service: No Issues, Degraded or Outage. What each state means is defined in prometheus/rules/70-service-status.yml.",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rl_service_status)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "All systems operational",
         "color": "#22C55E",
         "index": 0
        },
        "1": {
         "text": "Some services are degraded",
         "color": "#FFA726",
         "index": 1
        },
        "2": {
         "text": "Service outage",
         "color": "#EF4444",
         "index": 2
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22C55E",
        "value": null
       },
       {
        "color": "#FFA726",
        "value": 1
       },
       {
        "color": "#EF4444",
        "value": 2
       }
      ]
     },
     "noValue": "Status unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "text": {
     "valueSize": 40
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
